# Copy this file to keystore.properties. Never commit the populated file or keystore.
storeFile=/absolute/path/to/kpilot-release.jks
storePassword=change-me
keyAlias=kpilot-release
keyPassword=change-me

# For an interactive build without writing passwords to disk, use:
# ./scripts/package-release.sh /absolute/path/to/kpilot-release.jks kpilot-release
